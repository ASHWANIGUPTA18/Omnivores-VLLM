# ===========================================================================
# vLLM server configuration (inference/start-vllm.sh reads this).
#
# Separate from backend/.env on purpose: the model server is a separate
# process with a separate lifecycle, and often a separate machine.
# ===========================================================================

# --- Model (required) ------------------------------------------------------
# Pick one from config/models.yaml.
MODEL_NAME=Qwen/Qwen3-8B
# The id clients must send. Defaults to MODEL_NAME. Set a short alias here and
# in the backend's MODEL_NAME if you prefer.
SERVED_MODEL_NAME=

# --- Serving ---------------------------------------------------------------
VLLM_HOST=0.0.0.0
VLLM_PORT=8001

# --- Parallelism -----------------------------------------------------------
# 'auto' picks the largest power of two that fits the visible GPU count.
TENSOR_PARALLEL_SIZE=auto
PIPELINE_PARALLEL_SIZE=1

# --- Memory and context ----------------------------------------------------
# Larger contexts consume KV cache quadratically with concurrency. If startup
# fails with an out-of-memory error, lower this before anything else.
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=64
DTYPE=auto

# Leave empty unless the checkpoint is already in this format.
# fp8 | awq | gptq | bitsandbytes
QUANTIZATION=

# --- Tool calling ----------------------------------------------------------
# Required for the agents to use tools at all. The parser must match the model.
# Verify with: vllm serve --help | grep -A10 tool-call-parser
ENABLE_TOOL_CALLING=true
TOOL_CALL_PARSER=hermes
# Only needed if the model ships without a usable chat template.
CHAT_TEMPLATE=

# --- Access ----------------------------------------------------------------
# Set this AND keep the port off the public internet. vLLM's --api-key does
# not cover every endpoint; network isolation is the real control.
VLLM_API_KEY=

# --- Downloads -------------------------------------------------------------
# Where weights are cached. Point at a large, fast disk.
DOWNLOAD_DIR=
# Required for gated repositories (Llama, some Mistral models).
HF_TOKEN=

# Only for models that require custom code. It executes code from the model
# repository, so enable it only for repositories you trust.
TRUST_REMOTE_CODE=false

# Escape hatch for flags this script does not model.
EXTRA_ARGS=
