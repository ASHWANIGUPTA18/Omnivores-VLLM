# Omnivores - GPU stack configuration.
#
#   cp .env.example .env
#
# Read by docker-compose.gpu.yml via variable substitution. Values here are
# tuned for a single 24 GB Ampere card (RTX A5000 / 3090 / 4090).

# ---------------------------------------------------------------- model ----

# Must match an entry in inference/config/models.yaml. That file is a
# hand-maintained catalogue - no code reads it, so these two values are the
# real configuration.
#
#   Qwen/Qwen3-8B                       hermes        ~16 GB   fits 24 GB
#   Qwen/Qwen3-14B                      hermes        ~28 GB   does NOT fit
#   meta-llama/Llama-3.1-8B-Instruct    llama3_json   ~16 GB   gated, needs HF_TOKEN
#   mistralai/Mistral-Small-Instruct-2409  mistral    ~44 GB   does NOT fit
MODEL_NAME=Qwen/Qwen3-8B

# MUST match the model family or tool calling fails SILENTLY - the agents will
# produce confident prose and never call a tool. Verify the name exists in your
# vLLM build before the first run; see docs/RUNBOOK-GPU.md step 3.
TOOL_CALL_PARSER=hermes

# Optional short alias the API advertises instead of the full repo id.
SERVED_MODEL_NAME=

# Pin this. vLLM renames tool-call parsers between releases, and the compose
# default is "latest", which will eventually break your parser without warning.
VLLM_VERSION=latest

# ------------------------------------------------------------------ GPU ----

TENSOR_PARALLEL_SIZE=1
GPU_MEMORY_UTILIZATION=0.90

# 24 GB minus ~16 GB of bf16 weights leaves roughly 5-6 GB of KV cache, which
# is comfortable for a handful of concurrent users at this context length.
# Lower this first if vLLM fails to start with an out-of-memory error.
MAX_MODEL_LEN=32768

# vLLM's continuous-batching width. Far above any realistic demo load; two
# simultaneous questions are batched into the same forward pass.
MAX_NUM_SEQS=64

DTYPE=auto

# fp8 requires Hopper or Ada and will NOT work on Ampere. awq / gptq /
# bitsandbytes do. Leave empty for unquantized.
QUANTIZATION=

# Only needed for gated repos (Llama, some Mistral). Accept the licence on
# Hugging Face first.
HF_TOKEN=

# -------------------------------------------------------------- backend ----

LOG_LEVEL=INFO

# The runtime uses min(MAX_CONTEXT_TOKENS, what the server reports), so this
# should track MAX_MODEL_LEN. Leave headroom for the generated answer.
MAX_CONTEXT_TOKENS=28672
CONTEXT_RAG_TOKEN_BUDGET=6000

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# none | lexical | cross_encoder
# cross_encoder is more accurate but silently falls back to lexical if
# sentence-transformers is missing.
RERANKER=lexical

# disabled | docker | subprocess
# "docker" does NOT work as shipped - see the note in docker-compose.gpu.yml.
PYTHON_SANDBOX_MODE=disabled

# mock | tavily
# WARNING: "mock" returns FABRICATED results titled [SYNTHETIC RESULT n] at
# https://example.invalid/... and @researcher will cite them as if real. Use
# tavily with a key, or avoid asking @researcher anything web-facing.
WEB_SEARCH_PROVIDER=mock
TAVILY_API_KEY=

# LEAVE THIS EMPTY for a local demo. The frontend image bakes VITE_API_KEY in
# at build time and this stack passes none, so any value here makes the whole
# UI 401 and the WebSocket close with 1008. The backend is already bound to
# 127.0.0.1 by docker-compose.gpu.yml.
API_KEY=

CORS_ORIGINS=http://localhost:3000

# Extra flags appended to the vllm serve command.
# --reasoning-parser qwen3 sends Qwen3's <think> blocks to a separate
# response field so they do not appear in answers. Verified on vLLM
# with Qwen/Qwen3-8B; the parser name is model-family specific.
EXTRA_ARGS=--reasoning-parser qwen3
