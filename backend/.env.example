# ===========================================================================
# Omnivores AI - backend configuration
#
# Copy to `.env` and edit. Every value below has a working default, so an
# empty .env still boots in full development mode (no GPU, no API keys).
#
#   Laptop / CI      : LLM_PROVIDER=mock  EMBEDDING_PROVIDER=mock  VECTOR_STORE=memory
#   GPU workstation  : LLM_PROVIDER=vllm  EMBEDDING_PROVIDER=local VECTOR_STORE=chroma
#
# Switching between those two is a configuration change only. No source code
# in this repository imports vLLM, OpenAI or torch at module scope.
# ===========================================================================

# --- Application -----------------------------------------------------------
APP_ENV=development              # development | production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console               # console | json
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Inference -------------------------------------------------------------
# mock   : deterministic offline model, exercises streaming + tool calling
# vllm   : an OpenAI-compatible vLLM server (the production target)
# openai : the hosted OpenAI API
LLM_PROVIDER=mock

VLLM_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=
# Must match the model id the vLLM server reports at GET /v1/models.
MODEL_NAME=

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

INFERENCE_TIMEOUT_SECONDS=120
INFERENCE_CONNECT_TIMEOUT_SECONDS=10
INFERENCE_MAX_RETRIES=2

# --- Generation ------------------------------------------------------------
TEMPERATURE=0.3
TOP_P=0.95
MAX_OUTPUT_TOKENS=2048

# --- Agent runtime ---------------------------------------------------------
MAX_TOOL_ROUNDS=5
MAX_TOOL_CALLS=10
AGENT_TIMEOUT_SECONDS=120
TOOL_TIMEOUT_SECONDS=30
MAX_CONTEXT_TOKENS=16384
# Share of MAX_CONTEXT_TOKENS reserved for retrieved document context.
CONTEXT_RAG_TOKEN_BUDGET=4000
CONTEXT_RECENT_MESSAGES=20

# --- RAG -------------------------------------------------------------------
# mock  : deterministic hashed bag-of-words vectors, no model download
# local : sentence-transformers, runs on CPU or GPU
# openai: hosted embedding API
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32

# memory : pure-Python store persisted to JSON, zero extra dependencies
# chroma : persistent Chroma collection
VECTOR_STORE=memory
VECTOR_STORE_PATH=./data/vectorstore
CHROMA_COLLECTION=omnivores

CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
RAG_TOP_K=20
RAG_RERANK_TOP_K=5
RAG_MIN_SCORE=0.0

# none | lexical | cross_encoder
RERANKER=lexical
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Documents -------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./data/uploads
ALLOWED_EXTENSIONS=.pdf,.txt,.md,.docx

# --- Python sandbox --------------------------------------------------------
# disabled   : the python tool refuses to run (safe default)
# docker     : each execution runs in a throwaway, network-less container
# subprocess : DEV ONLY. Runs on the host. Never enable in production.
PYTHON_SANDBOX_MODE=disabled
PYTHON_SANDBOX_IMAGE=omnivores-sandbox:latest
PYTHON_TIMEOUT_SECONDS=15
PYTHON_MEMORY_LIMIT_MB=512
PYTHON_CPU_LIMIT=1.0
PYTHON_MAX_OUTPUT_CHARS=10000

# --- Web search ------------------------------------------------------------
# mock | tavily
WEB_SEARCH_PROVIDER=mock
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# --- Security --------------------------------------------------------------
# Leave empty to disable auth (development only). When set, clients must send
# `Authorization: Bearer <key>` on REST calls and ?token=<key> on the WebSocket.
API_KEY=
RATE_LIMIT_MESSAGES_PER_MINUTE=60
MAX_WEBSOCKET_CONNECTIONS=100
MAX_MESSAGE_LENGTH=8000
